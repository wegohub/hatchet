      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hatchet_olap_tidb_verified_plan == 1",
          "legendFormat": "{{instance}} {{query}} {{engine}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "TiFlash 副本可用性与进度",
      "datasource": {
