          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(table,route,result)(rate(hatchet_olap_tidb_read_route_total[5m]))",
          "legendFormat": "{{table}} {{route}} {{result}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "独立采样核验的引擎",
      "datasource": {
