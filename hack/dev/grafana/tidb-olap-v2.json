{
  "uid": "hatchet-tidb-olap-v2",
  "title": "Hatchet TiDB OLAP v2",
  "schemaVersion": 39,
  "version": 0,
  "tags": [
    "hatchet",
    "tidb",
    "olap"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "指标口径",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "可见性探针测量返回 run ID 到详情首次可读，完整样本和精确分位数以验收 JSON 为准\n\n仓储 created-to-published 包含队列等待，不能替代客户端可见性\n\nrequested route 与 sampled EXPLAIN ANALYZE engine 独立展示，未核验为 unknown；采样每模板最多每分钟一次，最多一条并发，超时 1 秒"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "可见性 p95 按后端",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(backend,le)(rate(hatchet_olap_visibility_probe_duration_seconds_bucket{phase=\"return_to_visible\"}[5m])))",
          "legendFormat": "{{backend}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "核心创建到 OLAP 发布 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(backend,kind,le)(rate(hatchet_olap_created_to_published_seconds_bucket[5m])))",
          "legendFormat": "{{backend}} {{kind}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "写入阶段 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(phase,le)(rate(hatchet_olap_tidb_phase_duration_seconds_bucket[5m])))",
          "legendFormat": "{{phase}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "详情与统计读取 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(backend,operation,le)(rate(hatchet_olap_read_duration_seconds_bucket[5m])))",
          "legendFormat": "{{backend}} {{operation}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "连接池等待总时间 / 秒",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance)(rate(hatchet_olap_tidb_pool_wait_seconds_total[5m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "连接池等待请求 / 秒",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance)(rate(hatchet_olap_tidb_pool_wait_total[5m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "连接池占用",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hatchet_olap_tidb_pool_connections",
          "legendFormat": "{{instance}} {{state}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "事务冲突 / 秒",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(operation)(rate(hatchet_olap_tidb_transaction_conflicts_total[5m]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "TiFlash 回退 / 秒",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(table,reason)(rate(hatchet_olap_tidb_tiflash_fallback_total[5m]))",
          "legendFormat": "{{table}} {{reason}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "请求路由 / 秒",
      "datasource": {
